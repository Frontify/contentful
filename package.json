{
  "name": "@contentful/frontify-assets",
  "version": "1.5.74",
  "private": true,
  "devDependencies": {
    "@contentful/app-scripts": "^2.5.12",
    "cross-env": "7.0.3",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "@contentful/dam-app-base": "^2.0.32",
    "@frontify/frontify-finder": "3.1.0-beta.6"
  },
  "scripts": {
    "build": "vite build --base=./ --outDir build --emptyOutDir",
    "deploy": "contentful-app-scripts upload --bundle-dir ./build --host api.contentful.com --organization-id ${DEFINITIONS_ORG_ID} --definition-id ${APP_DEFINITION_ID} --token ${CONTENTFUL_CMA_TOKEN} --comment \"${BUNDLE_COMMENT:-manual upload}\" --skip-activation",
    "deploy:test": "contentful-app-scripts upload --bundle-dir ./build --host api.contentful.com --organization-id ${TEST_ORG_ID} --definition-id ${TEST_APP_ID} --token ${CONTENTFUL_CMA_TOKEN} --comment \"${BUNDLE_COMMENT:-manual test upload}\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    "last 5 Chrome version",
    "> 1%",
    "not ie <= 11"
  ],
  "homepage": "."
}
